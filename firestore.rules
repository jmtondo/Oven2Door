rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function staff() { return role() == 'staff' || role() == 'admin'; }
    function rider() { return role() == 'rider'; }
    function allowedStatus(status) { return status in ['placed', 'preparing', 'ready_for_pickup', 'rider_assigned', 'picked_up', 'on_the_way', 'delivered', 'cancelled']; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'customer';
      allow read: if signedIn() && (request.auth.uid == userId || staff());
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status;
      allow update, delete: if staff();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.orderStatus == 'placed' && request.resource.data.paymentStatus == 'pending'
        && !request.resource.data.keys().hasAny(['assignedRiderId', 'assignedRiderName', 'riderLocation']);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.assignedRiderId == request.auth.uid || staff());
      allow update: if staff() && allowedStatus(request.resource.data.orderStatus);
      allow update: if rider() && resource.data.assignedRiderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'statusHistory', 'updatedAt', 'riderLocation'])
        && ((resource.data.orderStatus == 'rider_assigned' && request.resource.data.orderStatus == 'picked_up')
          || (resource.data.orderStatus == 'picked_up' && request.resource.data.orderStatus in ['picked_up', 'on_the_way'])
          || (resource.data.orderStatus == 'on_the_way' && request.resource.data.orderStatus in ['on_the_way', 'delivered']));
    }

    match /products/{document=**} { allow read: if true; allow write: if staff(); }
    match /categories/{document=**} { allow read: if true; allow write: if staff(); }
  }
}
